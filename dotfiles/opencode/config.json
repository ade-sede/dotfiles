{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@plannotator/opencode@latest"],
  "autoshare": false,
  "autoupdate": false,
  "model": "anthropic/claude-sonnet-4.5",
  "theme": "system",
  "provider": {
    "scaleway": {
      "options": {
        "apiKey": "{env:SCW_SECRET_KEY}",
        "baseURL": "https://api.scaleway.ai/{env:SCW_PROJECT_ID}/v1"
      }
    }
  }
}
